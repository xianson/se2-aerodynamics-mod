<Project Sdk="Microsoft.NET.Sdk">
  <!-- The control surface on its own (Components/ControlSurface.cs): the sign the mixer gives each surface against what a
       deflection really does, for any placement and airflow. The game-free core as AeroBench compiles it. -->
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Sim)\Core\*.cs" Exclude="$(Sim)\Core\Se2GridAccessor.cs" />
    <Compile Include="$(Sim)\Atmosphere\*.cs" />
    <Compile Include="$(Sim)\Drag\*.cs" />
    <Compile Include="$(Sim)\Lift\*.cs" />
    <Compile Include="$(Sim)\Shadow\*.cs" />
    <Compile Include="$(Sim)\Surface\*.cs" />
    <Compile Include="$(Sim)\Components\IAeroBlockComponent.cs" />
    <Compile Include="$(Sim)\Components\IFaceOverride.cs" />
    <Compile Include="$(Sim)\Components\ComponentForceResult.cs" />
    <Compile Include="$(Sim)\Components\LocalAeroConditions.cs" />
    <Compile Include="$(Sim)\Components\ControlSurface.cs" />
    <Compile Include="$(Sim)\Components\IControlSurfaceSettings.cs" />
    <Compile Include="$(Sim)\Components\ControlSurfaceGeometry.cs" />
    <Compile Include="$(Sim)\Propulsion\ThrustAllocator.cs" />
    <Compile Include="..\AeroBench\Shims.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- The settings menu's model (Scripts/Simulation/Ui/SettingsModel.cs, copied from the Orbital mod by its
       tools/sync_settings_ui.sh) over the REAL registry through this mod's adapter (Ui/SettingsTab.Mod.cs): the registry and
       store as SettingsTests compiles them, over its Stubs.cs. Program.cs is the Orbital mod's (synced). No Avalonia, no game. -->
  <ItemGroup>
    <Compile Include="$(Sim)\Runtime\AeroSettings.cs" />
    <Compile Include="$(Sim)\Runtime\AeroSettings.Store.cs" />
    <Compile Include="$(Sim)\Launch\QuickLaunchRules.cs" />
    <Compile Include="$(Sim)\Core\IGridAccessor.cs" />
    <Compile Include="$(Sim)\Core\SnapshotGridAccessor.cs" />
    <Compile Include="$(Sim)\Core\LongKey.cs" />
    <Compile Include="$(Sim)\Surface\ISurfaceProvider.cs" />
    <Compile Include="$(Sim)\Surface\NormalGroup.cs" />
    <Compile Include="$(Sim)\Surface\SurfaceFace.cs" />
    <Compile Include="$(Sim)\Surface\SmoothSurfaceProvider*.cs" />
    <Compile Include="$(Sim)\Structure\Model\*.cs" />
    <Compile Include="$(Sim)\Ui\SettingsModel.cs" />
    <Compile Include="$(Sim)\Ui\SettingsTab.Mod.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\SettingsTests\Stubs.cs" />
  </ItemGroup>
</Project>

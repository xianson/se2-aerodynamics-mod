<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Game2>C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers2\Game2</Game2>
  </PropertyGroup>
  <!-- Game assemblies are loaded from Game2 at run time (AssemblyResolve), never copied. -->
  <ItemGroup>
    <Reference Include="$(Game2)\VRage.Scripting.dll" Private="false" />
    <Reference Include="$(Game2)\Microsoft.CodeAnalysis.dll" Private="false" />
    <Reference Include="$(Game2)\Microsoft.CodeAnalysis.CSharp.dll" Private="false" />
    <Reference Include="$(Game2)\VRage.Library.dll" Private="false" />
    <Reference Include="$(Game2)\VRage.Core.dll" Private="false" />
    <Reference Include="$(Game2)\VRage.DCS.dll" Private="false" />
    <Reference Include="$(Game2)\VRage.Core.Game.dll" Private="false" />
    <Reference Include="$(Game2)\Game2.Simulation.dll" Private="false" />
    <Reference Include="$(Game2)\Game2.Client.dll" Private="false" />
    <Reference Include="$(Game2)\VRage.Physics.dll" Private="false" />
  </ItemGroup>
</Project>
